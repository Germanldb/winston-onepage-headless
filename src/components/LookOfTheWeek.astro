---
import LookSection from "./LookSection";
import { getLookOfTheWeekData } from "../lib/look";

interface Props {
    initialData?: any;
    titulo?: string;
    subtitulo?: string;
}

const { initialData: propData, titulo, subtitulo } = Astro.props;

let lookData = propData;
if (!lookData) {
    try {
        lookData = await getLookOfTheWeekData();
    } catch (e) {
        console.warn("[LookOfTheWeek Astro] Error fetching look in build-time:", e);
    }
}
---

<LookSection client:idle initialData={lookData} titleOverride={titulo} subtitleOverride={subtitulo} />
