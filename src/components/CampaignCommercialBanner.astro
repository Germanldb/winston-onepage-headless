---
interface Props {
    title: string;
    subtitle: string;
    ctaPrimaryText: string;
    ctaPrimaryLink: string;
    ctaSecondaryText: string;
    ctaSecondaryLink: string;
}

const { title, subtitle, ctaPrimaryText, ctaPrimaryLink, ctaSecondaryText, ctaSecondaryLink } = Astro.props;
---

<section class="commercial-banner">
    <div class="banner-content">
        <h2 class="banner-title">{title}</h2>
        <p class="banner-subtitle">{subtitle}</p>
        <div class="banner-ctas">
            <a href={ctaPrimaryLink} class="btn-primary">{ctaPrimaryText}</a>
            <a href={ctaSecondaryLink} class="btn-secondary">{ctaSecondaryText}</a>
        </div>
    </div>
</section>

<style>
    .commercial-banner {
        background-color: var(--color-green, #155338);
        color: #ffffff;
        padding: 4.5rem 2rem;
        text-align: center;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .banner-content {
        max-width: 800px;
        width: 100%;
    }

    .banner-title {
        font-family: var(--font-titles);
        font-size: clamp(1.5rem, 2.8vw, 2.25rem);
        text-transform: uppercase;
        letter-spacing: 3px;
        font-weight: 700;
        margin-bottom: 0.8rem;
        line-height: 1.3;
        color: #ffffff;
    }

    .banner-subtitle {
        font-family: var(--font-paragraphs);
        font-size: 0.95rem;
        color: #cccccc;
        margin-bottom: 2.2rem;
        letter-spacing: 1px;
    }

    .banner-ctas {
        display: flex;
        gap: 1.2rem;
        justify-content: center;
        flex-wrap: wrap;
    }

    .btn-primary, .btn-secondary {
        display: inline-block;
        padding: 0.85rem 2rem;
        font-family: var(--font-titles);
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 2px;
        text-decoration: none;
        font-weight: 600;
        transition: all 0.3s ease;
    }

    .btn-primary {
        background-color: #D4A853; /* Dorado W&H */
        color: #000000;
        border: 1px solid #D4A853;
    }

    .btn-primary:hover {
        background-color: transparent;
        color: #D4A853;
    }

    .btn-secondary {
        background-color: transparent;
        color: #ffffff;
        border: 1px solid #ffffff;
    }

    .btn-secondary:hover {
        background-color: #ffffff;
        color: #000000;
    }

    @media (max-width: 768px) {
        .commercial-banner {
            padding: 3.5rem 1.5rem;
        }
        .banner-ctas {
            flex-direction: column;
            gap: 0.8rem;
        }
        .btn-primary, .btn-secondary {
            padding: 0.8rem 1.5rem;
        }
    }
</style>
