---
// About.astro
interface Props {
    videoUrl?: string;
}

const { videoUrl = "/videos/hero-video.mp4" } = Astro.props;
---

<section id="nosotros" class="about-lv-hero js-about-section">
    <div class="video-container">
        <!-- Video HTML5 nativo y optimizado con precarga controlada -->
        <video 
            class="about-native-video js-about-video"
            preload="none"
            muted
            loop
            playsinline
            poster="https://img.youtube.com/vi/XGnN4DTsdD8/maxresdefault.jpg"
        >
            <source src={videoUrl} type="video/mp4" />
        </video>
        
        <!-- Overlay sutil para legibilidad -->
        <div class="video-overlay"></div>
    </div>

    <div class="container about-text-overlay">
        <div class="about-content-corner">
            <h2 class="about-title">
                Winston & Harry, <br />
                Maestros de la Tradición
            </h2>

            <p class="about-description">
                Winston & Harry nace de la pasión por el detalle y el respeto
                por las técnicas tradicionales de zapatería. Cada par es una
                obra única, confeccionada por manos colombianas que transforman
                los cueros más finos en piezas de arte para tus pies.
            </p>
        </div>
    </div>
</section>

<script>
    function setupAboutVideoObserver() {
        const section = document.querySelector('.js-about-section');
        const video = document.querySelector('.js-about-video') as HTMLVideoElement;

        if (!section || !video) return;

        // Intersection Observer para reproducción autónoma eficiente
        const observer = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
                if (entry.isIntersecting) {
                    // Cuando entra en pantalla, reproduce el video nativo
                    video.play()
                        .then(() => {
                            video.classList.add('is-playing');
                        })
                        .catch((err) => {
                            console.warn("[About Video] Auto-play no permitido o cancelado:", err);
                        });
                } else {
                    // Cuando sale de pantalla, pausa el video para ahorrar CPU y RAM
                    video.pause();
                }
            });
        }, {
            threshold: 0.15 // Dispara cuando el 15% de la sección es visible
        });

        observer.observe(section);
    }

    // Inicialización del observer para soporte SSR y Astro transitions
    setupAboutVideoObserver();
    document.addEventListener('astro:page-load', setupAboutVideoObserver);
</script>

<style>
    .about-lv-hero {
        position: relative;
        height: 100vh;
        width: 100%;
        overflow: hidden;
        background-color: #000;
        display: flex;
        align-items: flex-end; /* Alineamos el contenido abajo */
        padding-bottom: 8vh; /* Espacio desde el borde inferior */
        z-index: 10; /* Mayor que el banner anterior para el efecto parallax */
    }

    .video-container {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: 0;
        background-image: url('https://img.youtube.com/vi/XGnN4DTsdD8/maxresdefault.jpg');
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
    }

    /* Video nativo que cubre todo el fondo */
    .about-native-video {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        z-index: 0;
        opacity: 0;
        transition: opacity 1.2s cubic-bezier(0.16, 1, 0.3, 1);
    }

    /* Animación fluida de fundido cuando el video inicia reproducción */
    .about-native-video.is-playing {
        opacity: 0.75; /* Opacidad elegante para conservar legibilidad del texto */
    }

    .video-overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        /* Gradiente premium para proteger el texto */
        background: radial-gradient(
            circle at 10% 90%,
            rgba(0, 0, 0, 0.65) 0%,
            rgba(0, 0, 0, 0.25) 50%,
            transparent 100%
        );
        z-index: 1;
        pointer-events: none;
    }

    .about-text-overlay {
        position: relative;
        z-index: 10; /* Mayor que el overlay */
        width: 100%;
        padding: 0 4rem;
        pointer-events: none; /* Permite scroll natural */
    }

    .about-content-corner {
        max-width: 420px;
        color: #fff;
    }

    .about-title {
        font-family: var(--font-titles);
        font-size: clamp(1.5rem, 3vw, 2.2rem);
        font-weight: 700;
        line-height: 1.1;
        margin-bottom: 1.5rem;
        text-transform: uppercase;
        letter-spacing: 2px;
        color: #fff;
        text-shadow: 0 2px 10px rgba(0, 0, 0, 0.5);
    }

    .about-description {
        font-family: var(--font-paragraphs);
        font-size: 0.85rem;
        line-height: 1.6;
        font-weight: 300;
        margin-bottom: 2rem;
        color: rgba(255, 255, 255, 0.9);
        letter-spacing: 0.01em;
        text-shadow: 0 1px 5px rgba(0, 0, 0, 0.4);
    }

    @media (max-width: 768px) {
        .about-lv-hero {
            padding-bottom: 4rem;
        }
        .about-text-overlay {
            padding: 0 2rem;
        }
        .about-title {
            font-size: 1.8rem;
        }
    }
</style>
