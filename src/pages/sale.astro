---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import {
    getAllProducts,
    getCategoryTree,
    PUBLIC_WP_URL
} from "../lib/woocommerce";
import FilteredProductList from "../components/FilteredProductList";
import fs from "node:fs";
import path from "node:path";

// Pre-generar los archivos JSON del catálogo de ofertas durante el build-time (SSG)
const catalogDir = path.join(process.cwd(), "public", "data", "catalog");
if (!fs.existsSync(catalogDir)) {
    fs.mkdirSync(catalogDir, { recursive: true });
}

console.log("[SSG Sale] Iniciando descarga TOTAL para bypassear API defectuosa de WooCommerce...");

let page = 1;
let hasMore = true;
let allFetchedProducts: any[] = [];

// Acumulador para extraer todas las categorías que tengan productos en SALE
const seenCategories = new Map<number, { id: number, name: string, slug: string }>();

// 1. Descargar absolutamente todos los productos (100 por página para ir rápido)
while (hasMore) {
    try {
        console.log(`[SSG Sale] Descargando catálogo global - página ${page}...`);
        const pageProducts = await getAllProducts(100, page, "menu_order", "asc", false);
        
        if (!pageProducts || pageProducts.length === 0) {
            hasMore = false;
        } else {
            allFetchedProducts = allFetchedProducts.concat(pageProducts);
            page++;
        }
        
        if (page > 15) break; // Límite de seguridad
        await new Promise((r) => setTimeout(r, 100));
    } catch (err: any) {
        console.error(`[SSG Sale] Error descargando página ${page}:`, err.message);
        hasMore = false;
    }
}

// 2. Filtrar localmente usando la fórmula infalible de React
const allSaleProducts = allFetchedProducts.filter((p: any) => {
    const priceData = p?.prices || p;
    const regularPrice = Number(priceData.regular_price || 0);
    const price = Number(priceData.price || priceData.sale_price || 0);
    return p.on_sale || (regularPrice > price && price > 0);
});

// 3. Generar los chunks de 16 para la paginación inicial SSG
const chunkSize = 16;
let finalPages = 0;
for (let i = 0; i < allSaleProducts.length; i += chunkSize) {
    const chunk = allSaleProducts.slice(i, i + chunkSize);
    finalPages = Math.floor(i / chunkSize) + 1;
    fs.writeFileSync(path.join(catalogDir, `sale-p${finalPages}.json`), JSON.stringify(chunk, null, 2), "utf-8");
}

// Guardar página final vacía
const emptyFilePath = path.join(catalogDir, `sale-p${finalPages + 1}.json`);
fs.writeFileSync(emptyFilePath, JSON.stringify([], null, 2), "utf-8");

// NUEVO: Guardar el archivo unificado que el cliente de React usa para paginar y filtrar
const allFilePath = path.join(catalogDir, `sale-all.json`);
fs.writeFileSync(allFilePath, JSON.stringify(allSaleProducts), "utf-8");

// Alimentar la primera página al frontend SSG
const products = allSaleProducts.slice(0, chunkSize);

// Acumular categorías
allSaleProducts.forEach((product: any) => {
    if (Array.isArray(product.categories)) {
        product.categories.forEach((cat: any) => {
            if (cat && cat.id && cat.name && cat.slug) {
                seenCategories.set(cat.id, {
                    id: cat.id,
                    name: cat.name,
                    slug: cat.slug
                });
            }
        });
    }
});

console.log(`[SSG Sale] ✓ Catálogos estáticos de SALE generados manualmente. Total ofertas reales: ${allSaleProducts.length}`);

// Slugs de categorías que no deben mostrarse en los filtros
const IGNORED_CATEGORY_SLUGS = [
    'sin-categorizar',
    'uncategorized',
    'menos-de-350000',
    'menos-de-499000',
    'mas-de-500000',
    'menos-de-200000',
    'tallas-grandes-zapatos-hombre',
    'destacado'
];

// Procesamos las categorías únicas encontradas para alimentar el filtro lateral y el dropdown
const subcategories = Array.from(seenCategories.values())
    .filter(cat => {
        const slug = cat.slug.toLowerCase();
        if (IGNORED_CATEGORY_SLUGS.includes(slug)) return false;
        if (slug.includes('menos-de-') || slug.includes('mas-de-')) return false;
        if (slug === 'sale' || slug === 'ofertas') return false;
        return true;
    })
    .sort((a, b) => a.name.localeCompare(b.name));

const category = {
    id: "all",
    slug: "sale",
    name: "Sale",
    description: "Aprovecha precios especiales en nuestras últimas piezas. La misma calidad de cuero artesanal de Winston & Harry a un precio de oportunidad."
};
const navigationTree = await getCategoryTree();

const activeSort = {
    key: "descuentos",
    label: "Descuentos",
    orderBy: "menu_order",
    order: "asc",
    onSale: true,
};

const desktopBanner = "https://tienda.winstonandharrystore.com/wp-content/uploads/winston-and-harry-outlet-m.jpg";
const mobileBanner = desktopBanner;

const categoryTitle = "SALE";
const categoryDesc = "Aprovecha precios especiales en nuestras últimas piezas. La misma calidad de cuero artesanal de Winston & Harry a un precio de oportunidad.";

// Header de depuración para verificar el tiempo de generación en Vercel
Astro.response.headers.set('X-Generated-At', new Date().toISOString());
Astro.response.headers.set('Cache-Control', 'public, s-maxage=86400, stale-while-revalidate=43200');

const seoData = {
    title: "Sale | Winston & Harry",
    description: categoryDesc,
    opengraph_title: "Sale | Winston & Harry",
    opengraph_description: categoryDesc,
    opengraph_image: desktopBanner,
    opengraph_type: "website"
};
---

<Layout 
    title="Sale | Winston & Harry"
    seoData={seoData}
>
    <Header />

    <!-- Breadcrumbs -->
    <div class="breadcrumbs-container">
        <div class="breadcrumbs">
            <a href="/">Inicio</a>
            <span class="separator">/</span>
            <span class="current">Colección Sale</span>
        </div>
    </div>

    <main class="category-page">
        <section
            class="category-banner"
            style={`--desktop-banner: url('${desktopBanner}'); --mobile-banner: url('${mobileBanner}');`}
        >
            <div class="banner-overlay"></div>
            <div class="banner-content">
                <h1 style="color:#fff">{categoryTitle}</h1>
                <p set:html={categoryDesc} />
            </div>
        </section>

        <!-- Componente React de Filtros y Productos -->
        <FilteredProductList
            client:load
            initialProducts={products}
            category={category}
            subcategories={subcategories}
            colorTerms={[]}
            tallaTerms={[]}
            initialSort={activeSort}
            navigationTree={navigationTree}
        />
    </main>

    <Footer />
</Layout>

<style is:global>
    .category-page {
        min-height: 80vh;
        background-color: #fff;
    }

    /* Breadcrumbs */
    .breadcrumbs-container {
        max-width: var(--container-max-width);
        margin: 0 auto;
        padding: 2rem 2rem 1.5rem; /* Ajustado para el header fixed */
    }

    .breadcrumbs {
        display: flex;
        align-items: center;
        gap: 0.8rem;
        font-family: var(--font-paragraphs);
        font-size: 0.75rem;
        color: #888;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .breadcrumbs a {
        color: #888;
        text-decoration: none;
        transition: color 0.2s;
    }

    .breadcrumbs a:hover {
        color: var(--color-green);
    }

    .breadcrumbs .current {
        color: #333;
        font-weight: 600;
    }

    .category-banner {
        position: relative;
        height: 800px;
        background-color: var(--color-green);
        background-image: var(--desktop-banner);
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        display: flex;
        align-items: center;
        overflow: hidden;
    }

    @media (max-width: 768px) {
        .category-banner {
            background-image: var(--mobile-banner);
            height: 400px;
        }
    }

    .banner-overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.25);
        z-index: 1;
    }

    .banner-content {
        position: relative;
        z-index: 2;
        padding-left: 8%;
        color: #fff;
        max-width: 80%;
    }

    .banner-content h1 {
        font-family: var(--font-titles);
        font-size: 1.25rem;
        margin-bottom: 1rem;
        letter-spacing: 2px;
        text-transform: uppercase;
        max-width: 600px;
        color: #fff !important;
    }

    .banner-content p {
        font-family: var(--font-paragraphs);
        font-size: 0.8rem;
        line-height: 1.6;
        max-width: 500px;
        opacity: 0.9;
        color: #fff !important;
    }
</style>
